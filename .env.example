# Platform account. Set the password pair, or the shared-account key.
# With only CCNU_APP_PRIVATE_KEY the tool logs in with the account that the
# platform frontend uses, so no password is needed.
CCNU_ACCOUNT_ID=
CCNU_ACCOUNT_PASS=
CCNU_APP_PRIVATE_KEY=
CCNU_SYS_ID=999

# Target: set CCNU_METER_ID, or all four room variables.
CCNU_METER_ID=
CCNU_AREA=
CCNU_BUILDING=
CCNU_FLOOR=
CCNU_ROOM=

# DEBUG / INFO / WARNING / ERROR
CCNU_LOG_LEVEL=WARNING

# Tray refresh interval in minutes. Used by epower-tray only.
CCNU_REFRESH_MINUTES=60
