# Platform account issued to the CCNU electricity platform (required).
# Ask the campus utility office if you do not have one.
CCNU_ACCOUNT_ID=
CCNU_ACCOUNT_PASS=
CCNU_SYS_ID=999

# Target: set CCNU_METER_ID, or all four room variables.
CCNU_METER_ID=
CCNU_AREA=
CCNU_BUILDING=
CCNU_FLOOR=
CCNU_ROOM=

# DEBUG / INFO / WARNING / ERROR
CCNU_LOG_LEVEL=WARNING
